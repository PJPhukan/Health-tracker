rules_version = '2';

// Stock Plate — v2 stores only the user profile + goals in Firestore, at
// users/{uid} (goals is a nested map). Everything else stays in local SQLite.
// Each signed-in user may read and write only their own document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
